// Pilot only. Keep ingress off during upload; enable only after Access/config read-back.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "herreb-emp003-staging",
  "main": "../../src/staging/emp003-entry.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "EMP003_STAGING_ACCESS_TEAM_DOMAIN": "royal-dawn-3d8e.cloudflareaccess.com",
    "EMP003_STAGING_ACCESS_AUDIENCE": "cba5a2627ffef0aa423bf5e09046900f3373ae1cf76d326f500505566b00cb9a",
    "EMP003_STAGING_IDENTITY_MAP_JSON": "[{\"email\":\"dito2001@gmail.com\",\"actorId\":\"fernando\",\"tenantId\":\"herreb-client-0\",\"role\":\"owner\"},{\"email\":\"dito37@hotmail.com\",\"actorId\":\"dito37@hotmail.com\",\"tenantId\":\"herreb-emp003-test-b\",\"role\":\"user\"}]",
    "EMP003_RESEARCH_TENANT_ID": "herreb-client-0",
    "EMP003_RESEARCH_ALLOWED_HOSTS_JSON": "[\"developers.cloudflare.com\"]"
  },
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build:console"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      },
      {
        "class_name": "EMP002Operations",
        "name": "EMP002_OPERATIONS"
      },
      {
        "class_name": "WorkforceAdminState",
        "name": "WORKFORCE_ADMIN_STATE"
      },
      {
        "class_name": "EMP003CampaignState",
        "name": "EMP003_CAMPAIGN_STATE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EMP002Operations"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "WorkforceAdminState"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "EMP003CampaignState"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "herreb-emp003-pilot-db",
      "database_id": "a9a73690-6b31-4506-8a89-8d146bc9ce3e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STAGING_KV",
      "id": "39e5568f0a1d4a338416bef72f21ff28"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "account_id": "43147827695cce6931d9dc625ec240a7"
}
