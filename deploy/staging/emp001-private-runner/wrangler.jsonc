{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "herreb-emp001-private-runner-staging",
  "main": "./private-runner.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {"crons": []},
  "vars": {"PRIVATE_RUNNER_ENABLED": "false"},
  "services": [
    {"binding": "EMP001_RUNTIME_A", "service": "herreb-emp001-runtime-stg-a"},
    {"binding": "EMP001_RUNTIME_B", "service": "herreb-emp001-runtime-stg-b"}
  ]
}